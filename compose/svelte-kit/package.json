{
	"name": "app",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "npm run i18n:compile && node scripts/check-locale-parity.mjs && vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.23.2",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/leaflet": "^1.9.22",
		"@types/nodemailer": "^8.0.1",
		"@types/pngjs": "^6.0.5",
		"autoprefixer": "^10.5.4",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"postcss": "^8.5.26",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.6",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.0.5"
	},
	"type": "module",
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@libsql/client": "^0.17.4",
		"@lucia-auth/adapter-sqlite": "^3.0.2",
		"@node-rs/argon2": "^2.1.0",
		"@types/three": "^0.185.4",
		"leaflet": "^1.9.4",
		"lucia": "^3.2.2",
		"maplibre-gl": "^5.24.0",
		"node-datachannel": "^0.32.3",
		"node-mavlink": "^2.3.0",
		"nodemailer": "^9.0.5",
		"pngjs": "^7.0.0",
		"serialport": "^13.0.0",
		"three": "^0.185.1"
	},
	"overrides": {
		"@lucia-auth/adapter-sqlite": {
			"@libsql/client": "$@libsql/client"
		},
		"cookie": "^0.7.2",
		"xml2js": "^0.6.2"
	}
}
